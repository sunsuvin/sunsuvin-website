---
layout: base.njk
permalink: /contact/
title: Request Mentorship
description: Tell Sunsuvin what you're building and where you're stuck. We'll get
  back to you within two business days.
---
<header class="page-hero">
  <div class="container">
    <h1>{{ pages.contact.hero_heading }}</h1>
    <p>{{ pages.contact.hero_body }}</p>
  </div>
</header>

<section>
  <div class="container">
    <div class="form-wrap">
      <form id="mentorship-form" novalidate>
        <div class="field">
          <label for="name">Full name *</label>
          <input type="text" id="name" name="name" required autocomplete="name">
        </div>

        <div class="field">
          <label for="email">Email *</label>
          <input type="email" id="email" name="email" required autocomplete="email">
        </div>

        <div class="field">
          <label for="phone">Phone</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel">
        </div>

        <div class="field">
          <label for="company">Company / venture</label>
          <input type="text" id="company" name="company" autocomplete="organization">
        </div>

        <div class="field">
          <label for="interest">What are you looking for? *</label>
          <select id="interest" name="interest" required>
            <option value="">Select one</option>
            <option value="strategy-systems">Strategy &amp; Systems Mentorship</option>
            <option value="automation">Automation &amp; Digital Transformation Mentorship</option>
            <option value="sounding-board">Founder Sounding Board</option>
            <option value="audit">Operations &amp; Automation Audit</option>
            <option value="not-sure">Not sure yet</option>
          </select>
        </div>

        <div class="field">
          <label for="message">What are you working on, and where are you stuck? *</label>
          <textarea id="message" name="message" required></textarea>
          <p class="hint">The more specific, the more useful our first reply will be.</p>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%;">Request Mentorship</button>
        <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<section class="section-alt">
  <div class="container center" style="max-width:600px;">
    <h2>{{ pages.contact.email_heading }}</h2>
    <p>{{ pages.contact.email_body_before }} <a href="mailto:{{ site.contact_email }}" style="color:var(--gold); font-weight:600;">{{ site.contact_email }}</a> {{ pages.contact.email_body_after }}</p>
  </div>
</section>
